# 复制为 .env 后填写。不要把 .env 提交或分享。

# 必填：你的 PT 站用户 ID，例如 H&R 页面 hnr.php?id=1 就填 1。
HNR_USER_ID=1

# 必填：浏览器里复制出来的 CHDBits Cookie。
CHDBITS_COOKIE=

# 检查周期，单位分钟。例如 30 表示每 30 分钟检查一次。
HNR_CHECK_INTERVAL_MINUTES=30

# 完成时间连续多少小时不变化后提醒。
HNR_STALLED_AFTER_HOURS=24

# 同一条异常重复提醒间隔，单位小时。
HNR_NOTIFY_REPEAT_HOURS=12

# 显示和提醒使用的时区。
HNR_TIMEZONE=Asia/Shanghai

# 是否启用邮件提醒。
HNR_EMAIL_ENABLED=false

# SMTP 服务器配置。
HNR_SMTP_HOST=smtp.example.com
HNR_SMTP_PORT=465
HNR_SMTP_USE_SSL=true
HNR_SMTP_STARTTLS=false

# SMTP 用户名和密码。密码通常是邮箱授权码，不一定是登录密码。
HNR_SMTP_USERNAME=your-email@example.com
HNR_SMTP_PASSWORD=

# 发件人和收件人。多个收件人用英文逗号分隔。
HNR_EMAIL_FROM=your-email@example.com
HNR_EMAIL_TO=receiver@example.com

# Webhook 提醒，可选。
HNR_WEBHOOK_ENABLED=false
HNR_WEBHOOK_URL=

# 微信提醒：企业微信群机器人 Webhook，可选。
HNR_WECHAT_ENABLED=false
HNR_WECHAT_PROVIDER=wecom_robot
HNR_WECHAT_WEBHOOK_URL=
HNR_WECHAT_MSGTYPE=text

# 可选：提醒指定成员。手机号或企业微信用户 ID 多个用英文逗号分隔。
HNR_WECHAT_MENTION_MOBILES=
HNR_WECHAT_MENTION_USER_IDS=
HNR_WECHAT_AT_ALL=false
